<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        style="@style/AppBarLayoutStyle"
        >
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:title="@string/insights_title"
            style="@style/ToolbarStyle"
            />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/ScrollStyle"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/default_margin"
            >
            <TextView
                android:id="@+id/text_empty"
                style="@style/DefaultTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/insights_empty"
                android:visibility="gone"
                />
            <LinearLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/background_link_safety"
                        >
                        <TextView android:id="@+id/text_scanned" style="@style/LargeTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/SecondaryTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insights_scanned" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/background_link_safety"
                        >
                        <TextView android:id="@+id/text_created" style="@style/LargeTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/SecondaryTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insights_created" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/background_link_safety"
                        >
                        <TextView android:id="@+id/text_favorites" style="@style/LargeTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/SecondaryTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insights_favorites" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/background_link_safety"
                        >
                        <TextView android:id="@+id/text_active_days" style="@style/LargeTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/SecondaryTextViewStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insights_active_days" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/DefaultTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/insights_last_week"
                    />
                <com.qrbarcode.creator.feature.tabs.insights.WeekBarsView
                    android:id="@+id/week_bars"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp"
                    />
                <TextView
                    style="@style/DefaultTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/insights_top_types"
                    />
                <TextView
                    android:id="@+id/text_top_types"
                    style="@style/SecondaryTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    />
                <TextView
                    style="@style/DefaultTextViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/insights_top_formats"
                    />
                <TextView
                    android:id="@+id/text_top_formats"
                    style="@style/SecondaryTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    />
                <TextView
                    style="@style/SecondaryTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/insights_note"
                    />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
