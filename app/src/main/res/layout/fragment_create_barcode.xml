<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        app:elevation="0dp">

        <!-- Bento header: big title. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/jakarta_extrabold"
            android:letterSpacing="-0.03"
            android:text="@string/fragment_create_barcode_title"
            android:textColor="@color/default_text_color"
            android:textSize="32sp" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Hero tile: QR from what you just copied. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/button_clipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/blue"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bento_round_14"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_bold"
                            android:letterSpacing="-0.02"
                            android:text="@string/bento_hero_title"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.85"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/fragment_create_barcode_qr_code_clipboard"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bento_hero_circle"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_copy"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/button_text"
                style="@style/BentoTile">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/tile_blue_bg"
                        android:src="@drawable/ic_text"
                        app:tint="@color/tile_blue_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/fragment_create_barcode_qr_code_text" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="10dp" android:layout_height="1dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/button_url"
                style="@style/BentoTile">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/tile_violet_bg"
                        android:src="@drawable/ic_link"
                        app:tint="@color/tile_violet_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/barcode_schema_url" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/button_wifi"
                style="@style/BentoTile">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/tile_green_bg"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/tile_green_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/barcode_schema_wifi" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="10dp" android:layout_height="1dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/button_location"
                style="@style/BentoTile">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/tile_orange_bg"
                        android:src="@drawable/ic_location"
                        app:tint="@color/tile_orange_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/barcode_schema_geo" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/bento_more_codes"
                android:textColor="@color/default_text_color"
                android:textSize="17sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/button_contact_vcard"
                    style="@style/BentoListRow">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_contact"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/barcode_schema_v_card"
                        android:textColor="@color/default_text_color"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_bento"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/button_show_all_qr_code"
                    style="@style/BentoListRow">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/fragment_create_barcode_qr_code_show_all"
                        android:textColor="@color/default_text_color"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_bento"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/button_create_barcode"
                    style="@style/BentoListRow">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_barcode"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/fragment_create_barcode_show_all"
                        android:textColor="@color/default_text_color"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_bento"
                        app:tint="@color/secondary_text_color"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
